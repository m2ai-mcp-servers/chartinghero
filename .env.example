# ChartingHero MCP - environment configuration
# Copy to .env and fill in. Config fails closed: an invalid value aborts startup.

# Backend: mock (fictional patients) or fhir. Required when any FHIR_* var is set.
BACKEND=mock

# FHIR backend (BACKEND=fhir). The fhir backend itself lands in a later release.
# FHIR_BASE_URL=http://127.0.0.1:8080/fhir
# FHIR_ENVIRONMENT=local            # local or sandbox; production is not supported yet
# FHIR_WRITE=off                    # on only for hosts in src/config/hosts.ts WRITE_HOSTS
# FHIR_WRITE_PROFILE=full           # full or note-only
# FHIR_BEARER_TOKEN=
# FHIR_PRACTITIONER_ID=example-rn
# FHIR_IDENTIFIER_SYSTEM=https://memyselfplusai.com/fhir/chartinghero
# VISIT_TIMEZONE=America/New_York

# Demo dashboard projection (mock backend only, synthetic data only)
DASHBOARD_SYNC=off
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Logging: debug, info, warn or error
LOG_LEVEL=info
